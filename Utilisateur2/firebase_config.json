{
  "maintenance": {
    "enabled": true,
    "interval_hours": 6,
    "cleanup": {
      "rooms": {
        "enabled": true,
        "max_hours_inactive": 24,
        "description": "Supprimer les rooms inactives depuis plus de 24h"
      },
      "players": {
        "enabled": true,
        "max_days_inactive": 7,
        "description": "Supprimer les joueurs hors ligne depuis plus de 7 jours"
      }
    },
    "backup": {
      "enabled": true,
      "max_backups": 10,
      "description": "Garder maximum 10 sauvegardes"
    },
    "monitoring": {
      "enabled": true,
      "alert_thresholds": {
        "max_rooms": 1000,
        "max_players": 5000,
        "max_inactive_percentage": 80
      }
    }
  },
  "database": {
    "rules": {
      "rooms": {
        "read": true,
        "write": true,
        "index_on": ["code", "hostId", "gameState", "lastActivity"]
      },
      "players": {
        "read": true,
        "write": true,
        "index_on": ["isOnline", "lastSeen", "currentRoom"]
      }
    }
  },
  "security": {
    "auth": {
      "enabled": true,
      "anonymous_allowed": true,
      "max_rooms_per_user": 5
    },
    "rate_limiting": {
      "enabled": true,
      "max_requests_per_minute": 100
    }
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "retention_days": 30
  }
}
